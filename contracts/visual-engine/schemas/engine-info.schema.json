{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aios.internal/vec/v1/engine-info.schema.json",
  "title": "Engine info (GET /vec/v1/engine)",
  "type": "object",
  "required": ["engine_id", "engine_version", "engine_kind", "contract_versions", "status", "capabilities"],
  "properties": {
    "engine_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,63}$" },
    "engine_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "engine_kind": {
      "type": "string",
      "description": "contract_mock engines are test adapters. The platform never counts their outputs as production validation.",
      "enum": ["comfyui", "contract_mock", "other"]
    },
    "contract_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/ContractVersion" }
    },
    "status": { "type": "string", "enum": ["ready", "busy", "degraded", "maintenance"] },
    "capabilities": {
      "type": "object",
      "required": ["max_concurrent_jobs", "output_transfer"],
      "properties": {
        "max_concurrent_jobs": { "type": "integer", "minimum": 1 },
        "cancellation": { "type": "boolean" },
        "progress": { "type": "boolean" },
        "callbacks": { "type": "boolean" },
        "resource_release": { "type": "boolean" },
        "output_transfer": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/OutputTransfer" },
          "contains": { "const": "http_download" }
        }
      }
    },
    "gpu": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "vram_total_mb": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "conformance_mode": {
      "type": "boolean",
      "description": "true when the engine exposes the reserved __conformance__.* workflows."
    }
  }
}
