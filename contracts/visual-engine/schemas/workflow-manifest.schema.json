{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aios.internal/vec/v1/workflow-manifest.schema.json",
  "title": "Workflow manifest",
  "description": "Published by the visual engine (Track A) for every workflow version. A manifest describes WHAT a workflow accepts and returns, never HOW it works internally: no node graphs, no model names required. (key, version) is immutable: the same version must always have byte-identical semantics.",
  "type": "object",
  "required": ["contract_version", "workflow_key", "version", "task", "title", "input_schema", "outputs", "resources", "timeouts"],
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "workflow_key": { "$ref": "common.schema.json#/$defs/WorkflowKey" },
    "version": { "$ref": "common.schema.json#/$defs/Semver" },
    "task": { "$ref": "common.schema.json#/$defs/Task" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "input_schema": {
      "type": "object",
      "description": "JSON Schema (draft 2020-12) for job `parameters`. MUST be type object and SHOULD set additionalProperties:false. The platform validates parameters against it before submission; the engine MUST validate again.",
      "required": ["type"],
      "properties": { "type": { "const": "object" } }
    },
    "references": {
      "type": "object",
      "description": "Which reference inputs the workflow consumes.",
      "properties": {
        "persona_identity": {
          "type": "object",
          "properties": { "required": { "type": "boolean" } }
        },
        "assets": {
          "type": "object",
          "properties": {
            "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "adapters": {
          "type": "object",
          "properties": {
            "kinds": { "type": "array", "items": { "type": "string", "enum": ["lora", "other"] } },
            "max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["kind", "mime_types", "count"],
      "properties": {
        "kind": { "type": "string", "enum": ["image", "video"] },
        "mime_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["image/png", "image/jpeg", "image/webp", "video/mp4", "video/webm"] }
        },
        "count": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1, "maximum": 64 },
            "default": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "GPU coordination inputs. Figures MUST be measured on the target hardware (or null if not yet measured). The platform scheduler treats null vram_mb_peak as 'requires the whole media lane'.",
      "required": ["gpu_required"],
      "properties": {
        "gpu_required": { "type": "boolean" },
        "vram_mb_peak": { "type": ["integer", "null"], "minimum": 0 },
        "est_seconds_p50": { "type": ["number", "null"], "minimum": 0 },
        "est_seconds_p95": { "type": ["number", "null"], "minimum": 0 },
        "measured_on": { "type": ["string", "null"], "description": "Environment fingerprint id or hardware description of the measurement." },
        "preemptible": { "type": "boolean", "description": "true if the engine can cancel this workflow mid-run without corrupting state." },
        "default_priority": { "$ref": "common.schema.json#/$defs/PriorityClass" }
      }
    },
    "timeouts": {
      "type": "object",
      "required": ["max_runtime_s"],
      "properties": {
        "max_runtime_s": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "qa_checks": {
          "type": "array",
          "description": "Engine-side QA checks reported per output (QaResult.check values).",
          "items": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "c2pa": { "type": "string", "enum": ["engine_signs", "platform_signs", "none"] }
      }
    },
    "deprecated": { "type": "boolean" },
    "sunset_at": { "type": ["string", "null"], "format": "date-time" },
    "engine_metadata": {
      "type": "object",
      "description": "Opaque engine-private data. Stored by the platform for audit; never interpreted by business logic."
    }
  }
}
