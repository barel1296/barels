# ── Postgres (system of record) ─────────────────────────────────────────────
# App connects as the NON-superuser role so RLS actually applies.
DATABASE_URL=postgres://gros_app:gros_app@localhost:5432/gros
# Migrations and dev seeds run as the owner role.
DATABASE_URL_OWNER=postgres://gros:gros@localhost:5432/gros

# ── ClickHouse (analytics) ───────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=gros
CLICKHOUSE_USER=gros
CLICKHOUSE_PASSWORD=gros

# ── Redis (cache / future queues) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
# Generate with: openssl rand -hex 32  (NEVER commit real values)
JWT_ACCESS_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600
# Internal service token for worker->API calls (dev only; rotate in prod)
SERVICE_TOKEN=dev-service-token-change-me

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=GROS
API_INTERNAL_URL=http://localhost:3001

# ── Workers / LLM gateway ────────────────────────────────────────────────────
# Leave empty to run without LLM providers (agents fail loudly; scripted
# provider is used only by the eval harness, never in production paths).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_FRONTIER_MODEL=claude-sonnet-4-6
# Local evidence/transcript snapshot dir (S3-compatible store in prod)
ARTIFACT_DIR=./var/artifacts
WORKER_API_URL=http://localhost:3001
