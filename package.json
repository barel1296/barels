{
  "name": "aeroplane-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "A full-featured 3D aeroplane flight simulator game that runs in the browser (Three.js + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.170.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
