# =============================================================================
# Golden Influencer — environment template (complete).
#
# deploy/windows/install.ps1 copies this to <InstallRoot>\config\golden.env and
# fills in generated secrets. The file is read by every process with
# `node --env-file=...`. It contains secrets: keep it out of git, readable only
# by the service account, and back MASTER_KEY up OFFLINE.
#
# Nothing below hard-codes a machine: addresses default to loopback and paths
# are filled in by the installer from its -InstallRoot parameter.
# =============================================================================

# --- PostgreSQL (roles created by db:bootstrap or the docker compose file) -------
PG_SUPERUSER_PASSWORD=
PG_MIGRATOR_PASSWORD=
PG_APP_PASSWORD=
PG_WORKER_PASSWORD=
GOLDEN_DB=golden
PG_HOST=127.0.0.1
PG_PORT=5432
# aios_app: NOBYPASSRLS (API). aios_worker: background work. aios_migrator: migrations only.
DATABASE_URL=postgres://aios_app:CHANGE_ME@127.0.0.1:5432/golden
WORKER_DATABASE_URL=postgres://aios_worker:CHANGE_ME@127.0.0.1:5432/golden
MIGRATION_DATABASE_URL=postgres://aios_migrator:CHANGE_ME@127.0.0.1:5432/golden

# --- Platform process -----------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Base URL the visual engine uses to fetch signed reference assets from the platform.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Content-addressed media store (put it on the large NVMe volume).
MEDIA_ROOT=
# Optional: write-once exports of sealed audit batches.
AUDIT_EXPORT_DIR=
NODE_NAME=
# Session cookies require HTTPS unless this is false (only for http://127.0.0.1 use).
SESSION_COOKIE_SECURE=false
# SESSION_TTL_H=12
# SESSION_IDLE_MIN=120
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MIN=15
# TOTP_ISSUER=Golden Influencer

# --- Secrets (generated by the installer / `npm run cli -- keys:generate`) ----------
# Envelope-encryption master key (32 bytes, base64). Losing it makes every stored
# credential unrecoverable. Rotate by moving it to MASTER_KEY_PREVIOUS(_ID).
MASTER_KEY_ID=local-1
MASTER_KEY=
# MASTER_KEY_PREVIOUS_ID=
# MASTER_KEY_PREVIOUS=
# HMAC secret for short-lived signed asset URLs (>= 32 bytes, base64).
ASSET_URL_SECRET=
ASSET_URL_TTL_S=900
# HMAC secret for Telegram invoice payloads (defaults to ASSET_URL_SECRET).
INVOICE_SECRET=
# Bearer token for /metrics (Prometheus scraping).
METRICS_TOKEN=

# --- Visual engine (ComfyUI bridge or Track A engine) ------------------------------------
# Shared secret between the platform and the engine (>= 32 chars). Registered on the
# platform with POST /v1/platform/engines; the bridge reads it from here.
VEC_ENGINE_TOKEN=
# ComfyUI bridge (apps/platform/src/comfy-bridge). COMFYUI_URL comes from
# deploy/windows/discover-comfyui.ps1 (read-only discovery of the existing install).
COMFYUI_URL=
COMFY_BRIDGE_HOST=127.0.0.1
COMFY_BRIDGE_PORT=8190
COMFY_BRIDGE_ENGINE_ID=ws-comfyui
COMFY_BRIDGE_PACKAGES_DIR=
COMFY_BRIDGE_DATA_DIR=
COMFY_BRIDGE_MAX_CONCURRENT=1
COMFY_BRIDGE_INPUT_SUBFOLDER=golden-refs
COMFY_BRIDGE_CONFORMANCE=true
# COMFY_BRIDGE_POLL_MS=1000

# --- Worker / GPU scheduler (defaults shown) ------------------------------------------------
# DISPATCH_INTERVAL_MS=1000
# POLL_INTERVAL_MS=2000
# PUBLISH_INTERVAL_MS=10000
# ENGINE_HEALTH_INTERVAL_MS=30000
# ENGINE_HTTP_TIMEOUT_MS=10000
# JOB_MAX_ATTEMPTS=3
# RETRY_BASE_MS=10000
# RETRY_MAX_MS=300000
# AGING_STEP_S=600
# DEADLINE_URGENCY_S=900
# JOB_TIMEOUT_CAP_S=3600
# TIMEOUT_GRACE_S=120
# LEASE_S=60
# JOB_CONCURRENCY=4
# Policy placeholder, NOT a measured capacity: set from the capacity worksheet (docs/13 §7).
# DEFAULT_GPU_QUOTA_S_DAY=1800
# APPROVAL_TTL_H=72

# --- Local LLM (OpenAI-compatible server: llama.cpp, Ollama, LM Studio, vLLM) ----------------
# See deploy/windows/LOCAL-LLM.md. The model name is configuration only.
LLM_BASE_URL=
LLM_CHAT_MODEL=
# LLM_API_KEY=
# LLM_GUARD_MODEL=
# LLM_TIMEOUT_MS=60000
# LLM_MAX_CONCURRENCY=2
# LLM_MAX_REPLY_TOKENS=300
# LLM_TEMPERATURE=0.7
# LLM_CONTEXT_MESSAGES=20
# CONVERSATION_REPLY_DEBOUNCE_MS=2500
# Optional: let register-services.ps1 run a native llama.cpp server as a scheduled task
# (GoldenInfluencer-LLM). Its host/port come from LLM_BASE_URL and its served name from
# LLM_CHAT_MODEL. Leave LLM_SERVER_EXE empty if the LLM server is started some other way.
# LLM_SERVER_EXE=
# LLM_MODEL_PATH=
# LLM_SERVER_CTX=8192
# LLM_SERVER_PARALLEL=2
# LLM_SERVER_GPU_LAYERS=999
# LLM_SERVER_EXTRA_ARGS=

# --- Telegram ----------------------------------------------------------------------------------------
# Bot tokens are NOT stored here: connect each influencer's bot in the dashboard/API
# (stored encrypted per influencer).
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_POLL_TIMEOUT_S=25
# TELEGRAM_POLL_INTERVAL_MS=1000
# Closed beta: comma-separated Telegram user ids allowed to use the bots (empty = everyone).
TELEGRAM_ALLOWLIST_USER_IDS=
# SUBSCRIPTION_GRACE_H=48
# SUBSCRIPTION_PERIOD_S=2592000

# --- Publishing -----------------------------------------------------------------------------------------
# Adapters that may publish (comma-separated: instagram,telegram). Empty = nothing leaves the platform.
PUBLISHING_ADAPTERS=
# Instagram fetches media from this public HTTPS base URL (a tunnel or reverse proxy to
# /v1/assets/*/content only). Required for Instagram publishing.
PUBLIC_MEDIA_BASE_URL=
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# INSTAGRAM_GRAPH_VERSION=v23.0
# INSTAGRAM_CONTAINER_POLL_MS=5000
# INSTAGRAM_CONTAINER_TIMEOUT_S=300
# INSTAGRAM_MEDIA_METRICS=reach,likes,comments,saved,shares,views

# --- Monitoring ----------------------------------------------------------------------------------------
GPU_MONITOR_ENABLED=true
# GPU_MONITOR_COMMAND=nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw --format=csv,noheader,nounits
# GPU_SAMPLE_INTERVAL_MS=15000
# GPU_ALERT_TEMP_C=87
# GPU_ALERT_VRAM_PCT=97
# BACKUP_MAX_AGE_H=30

# --- Cost attribution (operator estimates; 0 = not configured) -------------------------------------
# COST_GPU_HOUR_USD=0
# COST_LLM_PER_1K_TOKENS_USD=0
# COST_FIXED_MONTHLY_USD=0
