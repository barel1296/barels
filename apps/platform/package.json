{
  "name": "@golden-influencer/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Golden Influencer platform (Track B): modular monolith — API, workers, visual engine gateway",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "cli": "tsx src/cli.ts",
    "mock-engine": "tsx src/mock-engine/main.ts",
    "conformance": "tsx src/conformance/main.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/integration/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/e2e/**/*.test.ts\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "jpeg-js": "0.4.4",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
